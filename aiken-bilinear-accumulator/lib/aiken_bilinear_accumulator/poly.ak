use aiken/builtin.{mod_integer}
use aiken/collection/list.{concat, foldl, map, map2}
use aiken/crypto/bls12_381/scalar.{Scalar,
  add, field_prime, mul, new, one, zero}

// Multiply a list of n coefficients that belong to a binomial each to get a final polynomial of degree n+1
//Example: for (x+2)(x+3)(x+5)(x+7)(x+11)=x^5 + 28 x^4 + 288 x^3 + 1358 x^2 + 2927 x + 2310
pub fn get_final_poly_int(binomial_poly: List<Int>) {
  let go =
    fn(term: Int, acc: List<Int>) {
      let shifted_poly = [0, ..acc]
      let multiplied_poly = map(concat(acc, [0]), fn(x) { x * term })
      map2(shifted_poly, multiplied_poly, fn(x, y) { x + y })
    }
  foldl(binomial_poly, [1], go)
}

// Like `get_final_poly_int` but reduce nodulo p on every step
pub fn get_final_poly_int_mod(binomial_poly: List<Int>) {
  let go =
    fn(term: Int, acc: List<Int>) {
      let shifted_poly = [0, ..acc]
      let multiplied_poly =
        map(concat(acc, [0]), fn(x) { mod_integer(x * term, field_prime) })
      map2(
        shifted_poly,
        multiplied_poly,
        fn(x, y) { mod_integer(x + y, field_prime) },
      )
    }
  foldl(binomial_poly, [1], go)
}

// fn modulo_add(a: Int, b: Int) -> Int {
//   let ret = a + b
//   if a < field_prime {
//     ret
//   } else {
//     ret - field_prime
//   }
// }

// Like `get_final_poly_int` but uses Scalar
pub fn get_final_poly_scalar(binomial_poly: List<Scalar>) {
  let go =
    fn(term: Scalar, acc: List<Scalar>) {
      let shifted_poly = [zero, ..acc]
      let multiplied_poly = map(concat(acc, [zero]), fn(x) { mul(x, term) })
      map2(shifted_poly, multiplied_poly, fn(x, y) { add(x, y) })
    }
  foldl(binomial_poly, [one], go)
}

pub fn make_scalars(iss: List<Int>) {
  let mkOrFail =
    fn(i: Int) {
      when new(i) is {
        Some(s) -> s
        None -> fail
      }
    }
  map(iss, mkOrFail)
}

test test_get_final_poly_int() {
  get_final_poly_int([2, 3]) == [6, 5, 1]
}

test test_get_final_poly_scalar() {
  get_final_poly_scalar(make_scalars([2, 3])) == make_scalars([6, 5, 1])
}

test test_get_final_poly_large() {
  get_final_poly_int([2, 3, 5, 7, 11]) == [2310, 2927, 1358, 288, 28, 1]
}

test test_get_final_poly_scalar_large() {
  get_final_poly_scalar(make_scalars([2, 3, 5, 7, 11])) == make_scalars(
    [2310, 2927, 1358, 288, 28, 1],
  )
}

test test_scalar_mul() {
  let s1 =
    when
      new(23028688090729445163723509241052290199566563106418427159558324016743)
    is {
      Some(s) -> s
      None -> fail
    }
  let s2 =
    when
      new(11615207285513499188821867516815580552008598385639274683799580493893)
    is {
      Some(s) -> s
      None -> fail
    }
  let ret =
    when
      new(
        46544242350868428373400004324316432187726970286569055591316009489257665708925,
      )
    is {
      Some(s) -> s
      None -> fail
    }
  mul(s1, s2) == ret
}

